{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "freeplex",
    "Audience": "freeplex-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "FreePlex": {
    "Database": {
      "ConnectionString": "Data Source=/config/freeplex.db"
    },
    "Paths": {
      "Config": "/config",
      "Downloads": "/downloads",
      "Transcodes": "/config/transcodes"
    },
    "Transcoding": {
      "HardwareAccel": "auto",
      "MaxConcurrentSessions": 3,
      "SegmentDurationSec": 2,
      "InitialSegmentDurationSec": 1,
      "AbrEnabled": true,
      "DefaultRemoteCapKbps": 8000
    },
    "Metadata": {
      "Language": "ru-RU",
      "FallbackLanguage": "en-US",
      "Tmdb": {
        "ApiKey": ""
      }
    },
    "Import": {
      "Watch": true,
      "MinFileSizeMb": 50,
      "Strategy": "Hardlink"
    },
    "Jobs": {
      "WorkerCount": 2
    }
  }
}
